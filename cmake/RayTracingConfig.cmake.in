@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Eigen3 CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/RayTracingCoreTargets.cmake")
set(RayTracing_Core_FOUND TRUE)
set(RayTracing_IO_FOUND FALSE)
if ("IO" IN_LIST RayTracing_FIND_COMPONENTS AND
        EXISTS "${CMAKE_CURRENT_LIST_DIR}/RayTracingIOTargets.cmake")
    # FindHDF5's C component needs the consuming project to enable C.
    find_dependency(nlohmann_json CONFIG)
    set(HDF5_USE_STATIC_LIBRARIES OFF)
    find_dependency(HDF5 MODULE COMPONENTS C)
    include("${CMAKE_CURRENT_LIST_DIR}/RayTracingIOTargets.cmake")
    set(RayTracing_IO_FOUND TRUE)
endif ()
check_required_components(RayTracing)
